# Copy to .env and adjust. Compose reads this file automatically.

# Published host port (container always listens on 8080 internally).
MIRROR_PORT=8092
# Bind address. 127.0.0.1 keeps the mirror off the internet until TLS is in front.
MIRROR_BIND=127.0.0.1

# Required by GET /api/submissions. Leave unset to close the read API entirely.
# Generate with: openssl rand -hex 32
MIRROR_ADMIN_TOKEN=

# Set to 1 ONLY when a reverse proxy in front sets X-Forwarded-For,
# otherwise the form rate limiter sees the proxy address instead of the client.
MIRROR_TRUST_PROXY=0
